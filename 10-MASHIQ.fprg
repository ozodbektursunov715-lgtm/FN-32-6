    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="MAXFIY, SON" type="Integer" array="False" size=""/>
            <assign variable="MAXFIY" expression="7"/>
            <output expression="&quot;SONNI KIRITING&quot;" newline="True"/>
            <input variable="SON"/>
            <while expression="SON!=MAXFIY">
                <output expression="&quot;XATO YANA KIRITING&quot;" newline="True"/>
                <input variable="SON"/>
            </while>
            <output expression="&quot; TOPDINGIZ&quot;" newline="True"/>
        </body>
    </function>
