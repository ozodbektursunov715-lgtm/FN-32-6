    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="i" type="Integer" array="False" size=""/>
            <declare name="xarajat, jami" type="Real" array="False" size=""/>
            <assign variable="jami" expression="0"/>
            <for variable="i" start="1" end="7" direction="inc" step="1">
                <output expression="&quot; - kun xarajatni kiriting&quot;" newline="True"/>
                <input variable="xarajat"/>
                <assign variable="jami" expression="jami +xarajat"/>
            </for>
            <output expression="&quot;Haftalik xarajat: &quot; &amp; jami" newline="True"/>
        </body>
    </function>
</flowgorithm>
